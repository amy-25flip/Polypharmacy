{
  "rules": [
    {
      "drugs": [
        "Metformin"
      ],
      "factor": "egfr",
      "below": 30,
      "level": "Avoid",
      "text": "Contraindicated when eGFR is below 30 (risk of lactic acidosis).",
      "source": "FDA Metformin label",
      "url": "https://dailymed.nlm.nih.gov/dailymed/search.cfm?labeltype=all&query=metformin"
    },
    {
      "drugs": [
        "Metformin"
      ],
      "factor": "egfr",
      "below": 45,
      "level": "Use with caution",
      "text": "Starting metformin is not recommended at eGFR 30 to 44. If already taking it, weigh benefit against risk and consider a lower dose.",
      "source": "FDA Metformin label",
      "url": "https://dailymed.nlm.nih.gov/dailymed/search.cfm?labeltype=all&query=metformin"
    },
    {
      "drugs": [
        "Ibuprofen",
        "Diclofenac",
        "Naproxen",
        "Ketorolac",
        "Celecoxib",
        "Indomethacin",
        "Meloxicam",
        "Piroxicam",
        "Etoricoxib",
        "Aceclofenac"
      ],
      "factor": "egfr",
      "below": 30,
      "level": "Avoid",
      "text": "Avoid NSAIDs when eGFR is below 30 (further kidney injury and fluid retention).",
      "source": "KDIGO CKD guideline (medication management)",
      "url": "https://kdigo.org/guidelines/ckd-evaluation-and-management/"
    },
    {
      "drugs": [
        "Ibuprofen",
        "Diclofenac",
        "Naproxen",
        "Ketorolac",
        "Celecoxib",
        "Indomethacin",
        "Meloxicam",
        "Piroxicam",
        "Etoricoxib",
        "Aceclofenac"
      ],
      "factor": "egfr",
      "below": 60,
      "level": "Use with caution",
      "text": "Avoid prolonged NSAID use at eGFR below 60, especially with an ACE inhibitor, ARB or diuretic.",
      "source": "KDIGO CKD guideline (medication management)",
      "url": "https://kdigo.org/guidelines/ckd-evaluation-and-management/"
    },
    {
      "drugs": [
        "Nitrofurantoin"
      ],
      "factor": "egfr",
      "below": 30,
      "level": "Avoid",
      "text": "Avoid when creatinine clearance is below 30 (poor urine levels and a higher risk of toxicity).",
      "source": "2023 AGS Beers Criteria (older adults)",
      "url": "https://doi.org/10.1111/jgs.18372"
    },
    {
      "drugs": [
        "Eplerenone"
      ],
      "factor": "egfr",
      "below": 30,
      "level": "Avoid",
      "text": "Contraindicated in hypertension when creatinine clearance is 30 or below (high potassium).",
      "source": "FDA Eplerenone label",
      "url": "https://dailymed.nlm.nih.gov/dailymed/search.cfm?labeltype=all&query=eplerenone"
    },
    {
      "drugs": [
        "Spironolactone"
      ],
      "factor": "egfr",
      "below": 45,
      "level": "Use with caution",
      "text": "Risk of high potassium rises as kidney function falls. Check potassium and creatinine closely.",
      "source": "FDA Spironolactone label",
      "url": "https://dailymed.nlm.nih.gov/dailymed/search.cfm?labeltype=all&query=spironolactone"
    },
    {
      "drugs": [
        "Rivaroxaban"
      ],
      "factor": "egfr",
      "below": 15,
      "level": "Avoid",
      "text": "Avoid when creatinine clearance is below 15.",
      "source": "FDA Rivaroxaban label",
      "url": "https://dailymed.nlm.nih.gov/dailymed/search.cfm?labeltype=all&query=rivaroxaban"
    },
    {
      "drugs": [
        "Enoxaparin"
      ],
      "factor": "egfr",
      "below": 30,
      "level": "Adjust dose",
      "text": "Dose reduction is needed when creatinine clearance is below 30.",
      "source": "FDA Enoxaparin label",
      "url": "https://dailymed.nlm.nih.gov/dailymed/search.cfm?labeltype=all&query=enoxaparin"
    },
    {
      "drugs": [
        "Digoxin"
      ],
      "factor": "egfr",
      "below": 60,
      "level": "Adjust dose",
      "text": "Cleared by the kidneys. A lower dose and drug-level monitoring are usually needed.",
      "source": "FDA Digoxin label",
      "url": "https://dailymed.nlm.nih.gov/dailymed/search.cfm?labeltype=all&query=digoxin"
    },
    {
      "drugs": [
        "Gabapentin",
        "Pregabalin"
      ],
      "factor": "egfr",
      "below": 60,
      "level": "Adjust dose",
      "text": "Dose must be reduced as kidney function falls (accumulation causes drowsiness and confusion).",
      "source": "FDA gabapentin and pregabalin labels",
      "url": "https://dailymed.nlm.nih.gov/dailymed/search.cfm?labeltype=all&query=gabapentin"
    },
    {
      "drugs": [
        "Colchicine"
      ],
      "factor": "egfr",
      "below": 30,
      "level": "Adjust dose",
      "text": "Dose reduction is needed in severe kidney impairment; toxicity is more likely.",
      "source": "FDA Colchicine label",
      "url": "https://dailymed.nlm.nih.gov/dailymed/search.cfm?labeltype=all&query=colchicine"
    },
    {
      "drugs": [
        "Lithium carbonate"
      ],
      "factor": "egfr",
      "below": 60,
      "level": "Use with caution",
      "text": "Reduced clearance raises the risk of lithium toxicity. Monitor drug levels closely.",
      "source": "FDA Lithium label",
      "url": "https://dailymed.nlm.nih.gov/dailymed/search.cfm?labeltype=all&query=lithium"
    },
    {
      "drugs": [
        "Glyburide"
      ],
      "factor": "egfr",
      "below": 60,
      "level": "Avoid",
      "text": "Long-acting sulfonylurea with active metabolites; prolonged low blood sugar is more likely when kidney function is reduced.",
      "source": "ADA Standards of Care and 2023 AGS Beers Criteria",
      "url": "https://doi.org/10.1111/jgs.18372"
    },
    {
      "drugs": [
        "Atenolol"
      ],
      "factor": "egfr",
      "below": 35,
      "level": "Adjust dose",
      "text": "Cleared by the kidneys. Dose reduction is needed when creatinine clearance is below 35.",
      "source": "FDA Atenolol label",
      "url": "https://dailymed.nlm.nih.gov/dailymed/search.cfm?labeltype=all&query=atenolol"
    },
    {
      "drugs": [
        "Diazepam",
        "Alprazolam",
        "Lorazepam",
        "Clonazepam",
        "Chlordiazepoxide",
        "Temazepam"
      ],
      "factor": "age",
      "at_least": 65,
      "level": "Avoid",
      "text": "Benzodiazepines raise the risk of falls, fractures, confusion and delirium in older adults.",
      "source": "2023 AGS Beers Criteria (older adults)",
      "url": "https://doi.org/10.1111/jgs.18372"
    },
    {
      "drugs": [
        "Zolpidem",
        "Eszopiclone",
        "Zaleplon"
      ],
      "factor": "age",
      "at_least": 65,
      "level": "Avoid",
      "text": "Sleep medicines of this kind carry the same risks of falls and confusion as benzodiazepines.",
      "source": "2023 AGS Beers Criteria (older adults)",
      "url": "https://doi.org/10.1111/jgs.18372"
    },
    {
      "drugs": [
        "Chlorpheniramine",
        "Hydroxyzine",
        "Diphenhydramine",
        "Promethazine",
        "Cyproheptadine"
      ],
      "factor": "age",
      "at_least": 65,
      "level": "Avoid",
      "text": "First-generation antihistamines are strongly anticholinergic (confusion, urinary retention, constipation).",
      "source": "2023 AGS Beers Criteria (older adults)",
      "url": "https://doi.org/10.1111/jgs.18372"
    },
    {
      "drugs": [
        "Amitriptyline",
        "Imipramine",
        "Clomipramine",
        "Doxepin"
      ],
      "factor": "age",
      "at_least": 65,
      "level": "Avoid",
      "text": "Strongly anticholinergic and sedating, and can cause low blood pressure on standing.",
      "source": "2023 AGS Beers Criteria (older adults)",
      "url": "https://doi.org/10.1111/jgs.18372"
    },
    {
      "drugs": [
        "Glyburide",
        "Chlorpropamide"
      ],
      "factor": "age",
      "at_least": 65,
      "level": "Avoid",
      "text": "Higher risk of prolonged low blood sugar than other sulfonylureas.",
      "source": "2023 AGS Beers Criteria (older adults)",
      "url": "https://doi.org/10.1111/jgs.18372"
    },
    {
      "drugs": [
        "Ketorolac"
      ],
      "factor": "age",
      "at_least": 65,
      "level": "Avoid",
      "text": "Higher risk of stomach bleeding and kidney injury.",
      "source": "2023 AGS Beers Criteria (older adults)",
      "url": "https://doi.org/10.1111/jgs.18372"
    },
    {
      "drugs": [
        "Ibuprofen",
        "Diclofenac",
        "Naproxen",
        "Indomethacin",
        "Meloxicam",
        "Piroxicam"
      ],
      "factor": "age",
      "at_least": 65,
      "level": "Use with caution",
      "text": "Avoid long-term use unless alternatives have failed; higher risk of stomach bleeding, kidney injury and raised blood pressure.",
      "source": "2023 AGS Beers Criteria (older adults)",
      "url": "https://doi.org/10.1111/jgs.18372"
    },
    {
      "drugs": [
        "Meperidine"
      ],
      "factor": "age",
      "at_least": 65,
      "level": "Avoid",
      "text": "Not an effective pain medicine at usual doses and can cause confusion and seizures.",
      "source": "2023 AGS Beers Criteria (older adults)",
      "url": "https://doi.org/10.1111/jgs.18372"
    },
    {
      "drugs": [
        "Cyclobenzaprine",
        "Methocarbamol",
        "Carisoprodol"
      ],
      "factor": "age",
      "at_least": 65,
      "level": "Avoid",
      "text": "Poorly tolerated muscle relaxants (sedation, confusion, falls) with doubtful benefit.",
      "source": "2023 AGS Beers Criteria (older adults)",
      "url": "https://doi.org/10.1111/jgs.18372"
    },
    {
      "drugs": [
        "Metoclopramide"
      ],
      "factor": "age",
      "at_least": 65,
      "level": "Avoid",
      "text": "Can cause movement disorders; avoid unless treating gastroparesis.",
      "source": "2023 AGS Beers Criteria (older adults)",
      "url": "https://doi.org/10.1111/jgs.18372"
    },
    {
      "drugs": [
        "Omeprazole",
        "Pantoprazole",
        "Esomeprazole",
        "Rabeprazole",
        "Lansoprazole"
      ],
      "factor": "age",
      "at_least": 65,
      "level": "Use with caution",
      "text": "Avoid courses longer than 8 weeks unless there is a clear reason (fracture, C. difficile infection and low magnesium or B12).",
      "source": "2023 AGS Beers Criteria (older adults)",
      "url": "https://doi.org/10.1111/jgs.18372"
    },
    {
      "drugs": [
        "Isotretinoin"
      ],
      "factor": "pregnancy",
      "possible": true,
      "level": "Avoid",
      "text": "Causes serious birth defects. Contraindicated in pregnancy; needs a negative pregnancy test and effective contraception before, during and for a month after treatment.",
      "source": "FDA Isotretinoin label",
      "url": "https://dailymed.nlm.nih.gov/dailymed/search.cfm?labeltype=all&query=isotretinoin"
    },
    {
      "drugs": [
        "Acitretin"
      ],
      "factor": "pregnancy",
      "possible": true,
      "level": "Avoid",
      "text": "Causes severe birth defects. Contraindicated in pregnancy, and pregnancy must be avoided for at least 3 years after stopping. Alcohol must be avoided during and for 2 months after treatment.",
      "source": "FDA Acitretin label",
      "url": "https://dailymed.nlm.nih.gov/dailymed/search.cfm?labeltype=all&query=acitretin"
    },
    {
      "drugs": [
        "Methotrexate"
      ],
      "factor": "pregnancy",
      "possible": true,
      "level": "Avoid",
      "text": "Can cause fetal death and birth defects. Contraindicated in pregnancy for non-cancer uses such as psoriasis and arthritis.",
      "source": "FDA Methotrexate label",
      "url": "https://dailymed.nlm.nih.gov/dailymed/search.cfm?labeltype=all&query=methotrexate"
    },
    {
      "drugs": [
        "Thalidomide"
      ],
      "factor": "pregnancy",
      "possible": true,
      "level": "Avoid",
      "text": "Causes severe, life-threatening birth defects. Use only under a pregnancy-prevention programme.",
      "source": "FDA Thalidomide label",
      "url": "https://dailymed.nlm.nih.gov/dailymed/search.cfm?labeltype=all&query=thalidomide"
    },
    {
      "drugs": [
        "Finasteride"
      ],
      "factor": "pregnancy",
      "possible": true,
      "level": "Avoid",
      "text": "Can harm a male fetus. Women who are or may be pregnant must not take it or handle crushed tablets.",
      "source": "FDA Finasteride label",
      "url": "https://dailymed.nlm.nih.gov/dailymed/search.cfm?labeltype=all&query=finasteride"
    },
    {
      "drugs": [
        "Mycophenolate mofetil"
      ],
      "factor": "pregnancy",
      "possible": true,
      "level": "Avoid",
      "text": "Boxed warning for pregnancy loss and birth defects. Needs pregnancy testing and contraception.",
      "source": "FDA Mycophenolate label",
      "url": "https://dailymed.nlm.nih.gov/dailymed/search.cfm?labeltype=all&query=mycophenolate"
    },
    {
      "drugs": [
        "Misoprostol"
      ],
      "factor": "pregnancy",
      "possible": true,
      "level": "Avoid",
      "text": "Can cause abortion, premature birth and birth defects.",
      "source": "FDA Misoprostol label",
      "url": "https://dailymed.nlm.nih.gov/dailymed/search.cfm?labeltype=all&query=misoprostol"
    },
    {
      "drugs": [
        "Valproic acid"
      ],
      "factor": "pregnancy",
      "possible": true,
      "level": "Avoid",
      "text": "Raises the risk of neural tube defects and lower IQ in the child. Use only if no alternative works.",
      "source": "FDA Valproate label",
      "url": "https://dailymed.nlm.nih.gov/dailymed/search.cfm?labeltype=all&query=valproate"
    },
    {
      "drugs": [
        "Warfarin"
      ],
      "factor": "pregnancy",
      "level": "Avoid",
      "text": "Crosses the placenta and can cause birth defects and bleeding. Contraindicated except in women with mechanical heart valves, under specialist care.",
      "source": "FDA Warfarin label",
      "url": "https://dailymed.nlm.nih.gov/dailymed/search.cfm?labeltype=all&query=warfarin"
    },
    {
      "drugs": [
        "Lisinopril",
        "Enalapril",
        "Ramipril",
        "Perindopril",
        "Captopril",
        "Losartan",
        "Telmisartan",
        "Valsartan",
        "Olmesartan",
        "Irbesartan",
        "Candesartan"
      ],
      "factor": "pregnancy",
      "level": "Avoid",
      "text": "Boxed warning for fetal toxicity. Stop as soon as pregnancy is detected.",
      "source": "FDA Lisinopril label",
      "url": "https://dailymed.nlm.nih.gov/dailymed/search.cfm?labeltype=all&query=lisinopril"
    },
    {
      "drugs": [
        "Doxycycline",
        "Minocycline",
        "Tetracycline"
      ],
      "factor": "pregnancy",
      "level": "Avoid",
      "text": "Can permanently discolour the developing teeth of the baby and affect bone growth. Avoid in pregnancy.",
      "source": "FDA Doxycycline label",
      "url": "https://dailymed.nlm.nih.gov/dailymed/search.cfm?labeltype=all&query=doxycycline"
    },
    {
      "drugs": [
        "Ibuprofen",
        "Diclofenac",
        "Naproxen",
        "Ketorolac",
        "Celecoxib",
        "Etoricoxib",
        "Aceclofenac"
      ],
      "factor": "pregnancy",
      "level": "Use with caution",
      "text": "Avoid from 20 weeks of pregnancy: can cause low amniotic fluid and fetal kidney problems.",
      "source": "US FDA drug safety communication on NSAIDs in pregnancy (2020)",
      "url": "https://www.fda.gov/drugs/drug-safety-and-availability/fda-recommends-avoiding-use-nsaids-pregnancy-20-weeks-or-later-because-they-can-result-low-amniotic"
    },
    {
      "drugs": [
        "Acetylsalicylic acid"
      ],
      "factor": "age",
      "at_least": 70,
      "level": "Use with caution",
      "text": "Avoid starting aspirin for primary prevention of heart disease in older adults; bleeding risk outweighs the benefit.",
      "source": "2023 AGS Beers Criteria (older adults)",
      "url": "https://doi.org/10.1111/jgs.18372"
    },
    {
      "drugs": [
        "Digoxin"
      ],
      "factor": "age",
      "at_least": 65,
      "level": "Use with caution",
      "text": "Avoid doses above 0.125 mg a day for atrial fibrillation or heart failure; toxicity is more likely.",
      "source": "2023 AGS Beers Criteria (older adults)",
      "url": "https://doi.org/10.1111/jgs.18372"
    }
  ],
  "note": "Decision-support cautions from published guidance; not yet reviewed by a clinician."
}
