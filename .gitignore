# Raw and processed data - large, regenerable from scripts, not meant for git
Datasets/
processed/*
!processed/indian_brand_names.json
!processed/indian_brand_names_summary.md

# Python
__pycache__/
*.pyc
.venv/
venv/

# Node / frontend build artifacts
webapp/frontend/node_modules/
webapp/frontend/dist/
webapp/frontend/.vite/

# Secrets - never commit API keys (but keep .env.example templates tracked)
.env
*.env
.env.*
!.env.example

# Local runtime logs (from self-hosting scripts, manual test runs, etc.)
*.log

# Editor/OS cruft
.DS_Store
Thumbs.db

# Scratch working directory for PPT editing (copies of source files, extracted
# media, LibreOffice profiles) - not project deliverables, not meant for git
.pptx_work/
